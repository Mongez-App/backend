# ============================================
# PostgreSQL Database
# ============================================
POSTGRES_USER=smartstudy
POSTGRES_PASSWORD=<SECRET_f9340f3c>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
IDENTITY_DB_NAME=identity_db
PLANNING_DB_NAME=planning_db

# ============================================
# Eureka Service Discovery
# ============================================
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka:8761/eureka/

# ============================================
# Firebase Authentication (identity-service)
# ============================================
# Path to Firebase service account JSON file
# For docker-compose: mount the file and set path inside container, e.g. /app/credentials/firebase-admin.json
FIREBASE_CREDENTIALS=/app/credentials/firebase-admin.json

# ============================================
# Spring Profiles
# ============================================
# dev = local development (ddl-auto: update)
# prod = production (ddl-auto: validate)
SPRING_PROFILES_ACTIVE=dev

# ============================================
# AI Processing Pipeline (planning-service)
# ============================================
# Gemini API key for embedding and vision OCR
GEMINI_API_KEY=AQ.Ab8RN6Jvhqp8wLeMP8k4PC-UrdfZWtwWUkbsBq6ZZbimPaR8Ig

# Qdrant vector database connection
QDRANT_HOST=qdrant
QDRANT_PORT=6334

# Material file storage directory
MATERIAL_STORAGE_DIR=uploads/materials

# --- AI Chat ---
# Gemini model for chat completions
GEMINI_CHAT_MODEL=gemini-2.0-flash
