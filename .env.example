# ============================================
# PostgreSQL Database
# ============================================
POSTGRES_USER=smartstudy
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
IDENTITY_DB_NAME=identity_db
PLANNING_DB_NAME=planning_db

# ============================================
# Eureka Service Discovery
# ============================================
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka:8761/eureka/

# ============================================
# Firebase Authentication (identity-service)
# ============================================
# Path to Firebase service account JSON file
# For docker-compose: mount the file and set path inside container, e.g. /app/credentials/firebase-admin.json
FIREBASE_CREDENTIALS=/app/credentials/firebase-admin.json

# ============================================
# Spring Profiles
# ============================================
# dev = local development (ddl-auto: update)
# prod = production (ddl-auto: validate)
SPRING_PROFILES_ACTIVE=dev

SPRING_AI_GOOGLE_GEMINI_API_KEY=your-gemini-key
GEMINI_API_KEY=your-gemini-key

# ============================================
# OpenRouter AI Provider (Fallback)
# ============================================
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
